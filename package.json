{
  "name": "@mothieras/pi-subagent",
  "version": "0.1.6",
  "description": "Isolated task delegation, Markdown roles, and session-local background agents for Pi.",
  "repository": { "type": "git", "url": "git+https://github.com/mothieras/pi-subagent.git" },
  "keywords": ["pi-package", "pi", "subagent"],
  "private": false,
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "license": "MIT",
  "files": [
    "*.ts",
    "agents/",
    "compat/",
    "docs/",
    "prompts/",
    "skills/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "INSTALL.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "pi": { "extensions": ["./index.ts"], "prompts": ["./prompts"], "skills": ["./skills"] },
  "scripts": {
    "test": "tsx --test --test-timeout=20000 tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.0.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
